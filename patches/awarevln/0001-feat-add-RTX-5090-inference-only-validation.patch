diff --git a/scripts/inference_only_demo.py b/scripts/inference_only_demo.py
new file mode 100644
index 0000000..f6eac26
--- /dev/null
+++ b/scripts/inference_only_demo.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""AwareVLN 独立8帧推理验证，不依赖 Habitat、Isaac Sim 或 ROS 2。"""
+
+import argparse
+from pathlib import Path
+
+import torch
+from PIL import Image
+
+from llava.constants import IMAGE_TOKEN_INDEX
+from llava.conversation import SeparatorStyle, conv_templates
+from llava.mm_utils import KeywordsStoppingCriteria, get_model_name_from_path, process_images, tokenizer_image_token
+from llava.model.builder import load_pretrained_model
+from llava.utils import disable_torch_init
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model-path", type=Path, default=Path("ck/awarevln"))
+    parser.add_argument("--image-dir", type=Path, required=True)
+    parser.add_argument("--instruction", required=True)
+    parser.add_argument("--load-4bit", action="store_true", help="低显存验证模式；输出可能与 FP16 略有差异。")
+    parser.add_argument("--max-new-tokens", type=int, default=128)
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+    model_path = args.model_path.expanduser().resolve()
+    image_dir = args.image_dir.expanduser().resolve()
+
+    # ==================== 中文修改：严格检查 AwareVLN 的8帧输入（开始） ====================
+    image_paths = sorted(
+        path for path in image_dir.iterdir() if path.suffix.lower() in {".jpg", ".jpeg", ".png"}
+    )
+    if len(image_paths) != 8:
+        raise ValueError(f"AwareVLN 需要正好8帧，当前目录包含 {len(image_paths)} 帧：{image_dir}")
+    images = [Image.open(path).convert("RGB") for path in image_paths]
+    # ==================== 中文修改：严格检查 AwareVLN 的8帧输入（结束） ====================
+
+    disable_torch_init()
+    model_name = get_model_name_from_path(str(model_path))
+    tokenizer, model, image_processor, _ = load_pretrained_model(
+        str(model_path), model_name, load_4bit=args.load_4bit, device_map="auto"
+    )
+
+    image_token = "<image>\n"
+    prompt_text = (
+        "Imagine you are a robot programmed for navigation tasks. You have been given a video "
+        f"of historical observations {image_token * 7}, and current observation <image>\n. "
+        f'Your assigned task is: "{args.instruction}" Analyze this series of images to decide your next action, '
+        "which could be turning left or right by a specific degree, moving forward a certain distance, "
+        "or stop if the task is completed."
+    )
+    conversation = conv_templates["llama_3"].copy()
+    conversation.append_message(conversation.roles[0], prompt_text)
+    conversation.append_message(conversation.roles[1], None)
+    prompt = conversation.get_prompt()
+
+    image_tensor = process_images(images, image_processor, model.config).to(model.device, dtype=torch.float16)
+    input_ids = tokenizer_image_token(prompt, tokenizer, IMAGE_TOKEN_INDEX, return_tensors="pt").unsqueeze(0)
+    input_ids = input_ids.to(model.device)
+    stop_text = conversation.sep if conversation.sep_style != SeparatorStyle.TWO else conversation.sep2
+    stopping = KeywordsStoppingCriteria([stop_text], tokenizer, input_ids)
+
+    with torch.inference_mode():
+        output_ids = model.generate(
+            input_ids,
+            images=image_tensor,
+            do_sample=False,
+            max_new_tokens=args.max_new_tokens,
+            # ==================== 中文修改：联合仿真前先降低推理峰值显存（开始） ====================
+            use_cache=False,
+            # ==================== 中文修改：联合仿真前先降低推理峰值显存（结束） ====================
+            stopping_criteria=[stopping],
+            pad_token_id=tokenizer.eos_token_id,
+        )
+    output = tokenizer.batch_decode(output_ids, skip_special_tokens=True)[0].strip()
+    if output.endswith(stop_text):
+        output = output[: -len(stop_text)].strip()
+    print("AwareVLN output:")
+    print(output)
+
+
+if __name__ == "__main__":
+    main()
