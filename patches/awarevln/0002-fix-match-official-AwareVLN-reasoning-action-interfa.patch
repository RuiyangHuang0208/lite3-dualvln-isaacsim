+def sample_and_pad_images(images, num_frames=8, width=512, height=512):
+    """复现官方评估：历史不足时前补黑帧，历史过长时均匀采样并保留最新帧。"""
+    frames = list(images)
+    if not frames:
+        raise ValueError("图像目录中至少需要一张 RGB 图像")
+    while len(frames) < num_frames:
+        frames.insert(0, Image.new("RGB", (width, height), color=(0, 0, 0)))
+    latest = frames[-1]
+    indices = np.linspace(0, len(frames) - 1, num=num_frames - 1, endpoint=False, dtype=int)
+    return [frames[index] for index in indices] + [latest]
+
+
+def build_question(instruction, previous_reasoning, steps_since_reasoning):
+    """构造与官方 AwareVLNTrainer 一致的 reasoning/action 二选一提示词。"""
+    history_tokens = "<image>\n" * 7
+    prefix = (
+        "Imagine you are a robot programmed for navigation tasks. You have been given a video "
+        f"of historical observations {history_tokens}, and current observation <image>\n. "
+        f'Your assigned task is: "{instruction}". '
+    )
+    if previous_reasoning:
+        prefix += f'The reasoning from {steps_since_reasoning} steps ago was: "{previous_reasoning}". '
+    return prefix + (
+        "Analyze this series of images to decide whether to predict the next action or to perform reasoning. "
+        "If action prediction, decide your next action, which could be turning left or right by a specific degree, "
+        "moving forward a certain distance, or stop if the task is completed. "
+        "If reasoning, describe your current observations, assess task progress, and provide a high-level plan "
+        "for the next steps."
+    )
+
+
+def clean_content(text):
+    for token in ("<|begin_of_text|>", "<|end_of_text|>", "<END_OF_REASONING>"):
+        text = re.sub(re.escape(token), "", text, flags=re.IGNORECASE)
+    return text.strip(" '\"\n\t")
+
+
+def nearest(value, choices):
+    return min(choices, key=lambda choice: abs(choice - value))
+
+
+def parse_awarevln_output(raw_output):
+    """把官方文本输出解析为稳定接口，供后续 ROS 2 控制器使用。"""
+    output = raw_output.strip()
+    mode = "reason" if output.lower().startswith(REASON_TOKEN.lower()) else "action"
+    if mode == "reason":
+        content = output[len(REASON_TOKEN) :]
+        return {"mode": "reason", "reasoning": clean_content(content), "action": None}
+
+    if output.lower().startswith(ACT_TOKEN.lower()):
+        output = output[len(ACT_TOKEN) :]
+    content = clean_content(output)
+    result = {"mode": "action", "reasoning": None, "action": "forward", "distance_cm": 25}
+    if re.search(r"\bstop\b", content, re.IGNORECASE):
+        result = {"mode": "action", "reasoning": None, "action": "stop"}
+    elif match := re.search(r"turn\s+left(?:\s+(\d+)\s*degree)?", content, re.IGNORECASE):
+        degree = nearest(int(match.group(1) or 15), (15, 30, 45))
+        result = {"mode": "action", "reasoning": None, "action": "left", "degree": degree}
+    elif match := re.search(r"turn\s+right(?:\s+(\d+)\s*degree)?", content, re.IGNORECASE):
+        degree = nearest(int(match.group(1) or 15), (15, 30, 45))
+        result = {"mode": "action", "reasoning": None, "action": "right", "degree": degree}
+    elif match := re.search(r"move\s+forward(?:\s+(\d+)\s*cm)?", content, re.IGNORECASE):
+        distance = nearest(int(match.group(1) or 25), (25, 50, 75))
+        result["distance_cm"] = distance
+    result["content"] = content
+    return result
+
